<resources>
    <style name="Theme.RedGrab" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/rg_red</item>
        <item name="android:windowBackground">@color/rg_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.RedGrab.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rg_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RedGrab</item>
    </style>
</resources>
